    "verify-cards": "node scripts/verify-cards.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "avr8js": "0.21.0",
    "openai": "^7.43.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
